function updateui()
	if btnp(⬅️) then
		selector.x-=8
	end
	if btnp(➡️) then
		selector.x+=8
	end
	if btnp(⬆️) then
		selector.y-=8
	end
	if btnp(⬇️) then
		selector.y+=8
	end
	selector_contain()
end

function make_selector()
		selector=makespr()
		selector.x=0
		selector.y=16
		selector.spr=54
end

function draw_selector()
	drawspr(selector)
end

function selector_contain()
	if selector.x<=0 then
		selector.x=0
	end
	if selector.x>=56 then
		selector.x=56
	end
	if selector.y<=16 then
		selector.y=16
	end
	if selector.y>=40 then
		selector.y=40
	end
end

