function right_ui()
		--routline
	rect(69,5,127,34,5)
	rect(70,6,126,33,7)
	rect(71,7,125,32,1)
	line(96,7,96,32,6)
	line(95,7,95,31,1)
	line(97,7,97,31,1)
	
	--plr info
	if plr.eng>0 then
		if t%30>25 then
			pal(11,10)
		end 
		print('fast',98,8,11)
		print('strong',98,16,11)
	else
		if t%30>10 then
			pal(9,8)
		end 
		print('slow',98,8,9)
		print('poor',98,16,9)
	end
	
	--inv
		local xf=0
		for pu in all(plr.inv) do
			pu.x=98+xf
			pu.y=24
			if pu.type==2 then
				pu.spr=49
			elseif pu.type==1 then
				pu.spr=50
			end
				drawspr(pu)
				xf+=5
		end
	
	--charge bar
	engamt=plr.eng/plr.maxeng
	print('charge: ',69,0,7)
	rect(96,0,127,4,6)
	if plr.eng>0 then
		rectfill(97,1,97+flr((engamt*29)),3,10)
	else
		print('press z to charge battery',2,122,7)
	end
end

function upgrade_system()
for up in all(upgrades) do
		if col(selector,up) then
			if btnp(❎) then
				if plr.lvl+up.bcost<=batcount and
				plr.lvl+up.scost<=scrapcount then
					batcount-=plr.lvl+up.bcost
					scrapcount-=plr.lvl+up.scost
					if up.type==1 then
						plr.usx+=.1
						up.bcost+=1
						up.scost+=3
					elseif up.type==2 then
						plr.umspd+=5
						up.bcost+=1
						up.scost+=3
					elseif up.type==3 then
						plr.umeng+=0.5
						up.bcost+=1
						up.scost+=3
					elseif up.type==4 then
						plr.umdmg+=5
						up.bcost+=1
						up.scost+=3
					end
				else
					sfx(0)
					return
				end
			end
		end
	end
end