--ui

function draw_plrui()
	pal()
	left_ui()
	right_ui()

	
end

function updateui()
	if btnp(⬅️) then
		selector.x-=8
	end
	if btnp(➡️) then
		selector.x+=8
	end
	if btnp(⬆️) then
		selector.y-=8
	end
	if btnp(⬇️) then
		selector.y+=8
	end
	if btnp(🅾️) then
		if plr.eng<=0 then
			batcount-=1
			pufloat(36,plr.x,plr.y-2,plr.y-10)
			plr.eng=plr.maxeng
		else
			sfx(0)
		end
	end
	upgrade_system()
	selector_contain()
end

function make_selector()
		selector=makespr()
		selector.x=0
		selector.y=16
		selector.spr=54
		selector.type='selector'
		selector.colw=4
		selector.colh=4
end

function draw_selector()
	if t%30>25 then
			pal(6,7)
	end 
	drawspr(selector)
	pal()
end

function selector_contain()
	if selector.x<=0 then
		selector.x=0
	end
	if selector.x>=56 then
		selector.x=56
	end
	if selector.y<=16 then
		selector.y=16
	end
	if selector.y>=40 then
		selector.y=40
	end
end

