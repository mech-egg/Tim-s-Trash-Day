function draw_floats()
	for myfl in all(flts) do
	local colr=7
	if t%4<2 then
		colr=8
	end
		cprint(myfl.txt,myfl.x,myfl.y,colr)
		myfl.y+=(myfl.posy-myfl.y)/7
		myfl.age+=1
		if myfl.age>=30 then
			del(flts,myfl)	
		end
	end
end

function draw_pu()
	for pu in all(pickups) do
		drawspr(pu)
		pu.y+=(pu.posy-pu.y)/7
		if pu.spr==32 and pu.src==1 then
			pu.x+=(plr.x+2-pu.x)/2
		elseif pu.spr==36 and pu.src==1 then
			pu.x+=(plr.x-pu.x)/2
		end
		pu.age+=1
		if pu.age>=30 then
			del(pickups,pu)	
		end
	end
end

function draw_p()
	for p in all(parts) do
		local pc=7
		--logic for color change
		if p.age>22 then
			pc=1
		elseif p.age>18 then
			pc=13
		elseif p.age>12 then
			pc=5
		elseif p.age>8 then
			pc=6
		end
		p.age+=1
		p.sx=p.sx*.85
		p.sy=p.sy*.85
		circfill(p.x,p.y,p.rd,pc)
		p.x+=p.sx
		p.y+=p.sy
		if p.age>15 and p.rd>0.5 then
			p.rd-=.5
		end
		if p.age>p.maxage then
			del(parts,p)
		end
	end
end


function draw_pp()
	for pp in all(pparts) do
		local pc=11
		if pp.clr==1 then
			pc=10
		end
		pp.age+=1

		circfill(pp.x,pp.y,pp.rd,pc)
		if pp.age>15 then
			pp.sx=(pp.sx)*1.75
			pp.sy=pp.sy*1.25
			pp.x+=(plr.x+4-pp.x)/6
			pp.y-=pp.sy
		--	if abs(plr.x+4-pp.x)<2 and pp.y>plr.y+4 then
				--del(pparts,pp)
			if pp.y>108 then
				del(pparts,pp)
			end
		else
			pp.sx=pp.sx*.85
			pp.sy=pp.sy*.85
			pp.x+=pp.sx
			pp.y+=pp.sy
		end
		if pp.age>15 and pp.rd>0.5 then
			pp.rd-=.5
		end
		if pp.age>pp.maxage then
			del(pparts,pp)
		end
	end
end

