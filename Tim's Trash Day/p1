function update_intro_scene()

	if #units<1 and plr.x<120 then
			sfx(18)
			spawn_trashman()
	end
	for tman in all(units) do
		tman.y=56
		tman.x+=tman.sx
			if tman.x<=40 then
				tman.sx=2
			end
			if tman.x>140 then
				del(units,tman)
				state='intro2'
				lockout=t+120
			end
		end
		
		for pile in all(garbage) do
			if pile.y<60 then
				pile.y=64
			end
			if pile.spr==12 then
				pile.spr=11
			end
			pile.drop=40
			pile.x+=pile.sx
			pile.y+=pile.sy
			--check tman turn
			if pile.x<=pile.drop then
				--drop block
				local lx=pile.x
				local ly=pile.y
				pile.x=pile.drop
				pile.sy=1
				pile.sx=0
				--check col with block
				if fcol(pile,0) then
					pile.x=lx
					pile.y=ly-1
					gstop(pile)
				end
			end
		end
end

