function update_col()
	for lguy in all(units) do
		for enm in all(enms) do
			if col(lguy,enm) then
			--lguy
				lguy.sx=0
				lguy.msn='atk'
			--enm
				enm.sx=0
				enm.msn='atk'
				combat(lguy,enm)
			end
		end
	end
end

function friend_col(arr)
	for i=1,#arr do
		for j=i+1,#arr do
			local	obj1=arr[i]
			local obj2=arr[j]
			if col(obj1,obj2) then
				obj1.sx=0
				obj2.sx=0
			end
		end
	end
end



		
function combat(lguy,enm)
--atk seq
	if t%lguy.atkspd==0 then
		enm.life-=lguy.dmg
		popfloat(lguy.dmg,enm.x+5,enm.y-2,enm.y-8,7)
		if enm.life<=0 then
			lguy.msn='walk'
			lguy.sx=0.75
			del(enms,enm)
		end
	end
	
		if t%enm.atkspd==0 then
		lguy.life-=enm.dmg
		popfloat(enm.dmg,lguy.x+3,lguy.y-2,lguy.y-8,12)
		if lguy.life<=0 then
			enm.msn='walk'
			enm.sx=-0.75
			del(units,lguy)
		end
	end
end