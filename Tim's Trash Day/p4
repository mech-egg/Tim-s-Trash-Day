--trash men

function draw_tmen()
	for tman in all(units) do
		drawspr(tman)
	end
end

function spawn_trashman()
	 local tman=makespr()
		tman.x=136
		tman.life=300
		tman.dmg=40
		tman.y=36
		tman.sx=-0.75
		tman.spr=48
		tman.msn='deliver'
		tman.turn=55+flr(rnd(61))
		add(units,tman)
		spawn_gpile(tman)
end

function move_tman(tman)
			tman.x+=tman.sx
		--if guy in front<8px stop
		--if enm <8px in front stop
		--msn atck
		if tman.x>140 then
			del(units,tman)
		elseif tman.x<=tman.turn then
			tman.sx=2
		end
		
end

function tman_logic()
	if t%enemyfreq==0 then
		if #units<1 then
			spawn_trashman()
		end
	end
	for tman in all(units) do
		if tman.msn=='deliver' then
			move_tman(tman)
		end
	--check gpile locations
	--drop gpile
	--go get some more0.
	
	end
end


