function draw_tmen()
	for tman in all(units) do
		drawspr(tman)
	end
end

function spawn_trashman()
	 local tman=makespr()
		tman.x=8
		tman.life=300
		tman.dmg=40
		tman.y=56
		tman.sx=0.75
		tman.spr=48
		tman.msn='deliver'
		add(units,tman)
		spawn_gpile(tman)
end

function move_tman(tman)
			tman.x+=tman.sx
		--if guy in front<8px stop
		--if enm <8px in front stop
		--msn atck
		if tman.x<-8 then
			del(units,tman)
		elseif tman.x>=120 then
			tman.sx=-2
		end
		
end

