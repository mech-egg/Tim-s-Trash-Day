--units

function draw_units()
	for lguy in all(units) do
		drawspr(lguy)
	end
end

function spawn_units()
	 local lguy=makespr()
		lguy.x=8
		lguy.life=300
		lguy.dmg=40
		lguy.y=104
		lguy.sx=0.75
		lguy.spr=16
		lguy.msn='walk'
		lguy.atkspd=29
		add(units,lguy)
end

function move_units(lguy)
			lguy.x+=lguy.sx
		--if guy in front<8px stop
		--if enm <8px in front stop
		--msn atck
		if lguy.x>136 then
			del(units,lguy)
		end
end

