--garbage

--generate garbage
function spawn_gpile(tman)
	if tman==nil then
			gpile=makespr()
			gpile.drop=tman.turn
			gpile.x=tman.x
			gpile.y=tman.y+7
			gpile.spr=11
			gpile.life=100
			gpile.sx=tman.sx
			gpile.id=garbageid
			gpile.msn='drop'
			add(garbage,gpile)
	elseif rnd()<.5 then
			gpile=makespr()
			gpile.drop=tman.turn
			gpile.x=tman.x
			gpile.y=tman.y+7
			gpile.spr=11
			gpile.life=100
			gpile.sx=tman.sx
			gpile.id=garbageid
			gpile.msn='drop'
			add(garbage,gpile)
	else
			gpile=makespr()
			gpile.drop=tman.turn
			gpile.x=tman.x
			gpile.y=tman.y+7
			gpile.spr=12
			gpile.life=100
			gpile.sx=tman.sx
			gpile.id=garbageid
			gpile.msn='drop'
			add(garbage,gpile)
	end
end

function draw_garbage()
	for gpile in all(garbage) do
		drawspr(gpile)
	end
end
--remove garbage

--move garbage around
function update_gpile()
	for pile in all(garbage) do
		debug=plr.umspd
		if pile.msn=='sit' then
			if friend_col(pile,garbage)==false and fcol(pile,0)==false then
				pile.msn='drop'
				pile.sy=1
			else
				gstop(pile)
			end 
		end
		if pile.msn=='drop' then
		--mission drop
		
			pile.x+=pile.sx
			pile.y+=pile.sy
			--check tman turn
			if pile.x<=pile.drop then
				local lx=pile.x
				local ly=pile.y
				--drop block
				pile.x=pile.drop
				pile.sy=1
				pile.sx=0
				--check col with block
				if fcol(pile,0) then
					pile.x=lx
					pile.y=ly-1
					gstop(pile)
				elseif friend_col(pile,garbage) then
					pile.x=lx
					pile.y=ly-1
					gstop(pile)
				end
			end
		end
	end
end


function gstop(pile)	
	pile.sy=0
	pile.sx=0
	pile.msn='sit'
end