--generate garbage
function spawn_gpile(tman)
	if tman==nil then
			gpile=makespr()
			gpile.drop=tman.turn
			gpile.x=tman.x
			gpile.y=tman.y+8
			gpile.spr=11
			gpile.life=40
			gpile.sx=tman.sx
			gpile.id=#gpile+1
			add(garbage,gpile)
	elseif rnd()<.5 then
			gpile=makespr()
			gpile.drop=tman.turn
			gpile.x=tman.x+1
			gpile.y=tman.y+8
			gpile.spr=11
			gpile.life=40
			gpile.sx=tman.sx
			gpile.id=#gpile+1
			add(garbage,gpile)
	else
			gpile=makespr()
			gpile.drop=tman.turn
			gpile.x=tman.x+1
			gpile.y=tman.y+8
			gpile.spr=12
			gpile.life=40
			gpile.sx=tman.sx
			gpile.id=#gpile+1
			add(garbage,gpile)
	end
end

function draw_garbage()
	for gpile in all(garbage) do
		drawspr(gpile)
	end
end
