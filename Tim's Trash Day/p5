--player functions

function create_plr()
	plr=makespr()
		plr.x=8
		plr.y=104
		plr.spr=16
		plr.sx=1
		plr.mxinv=1
		plr.inv={}
		plr.flip=false
		plr.msn='walk'
		--leveling
		plr.lvl=1
		plr.exp=0
		plr.maxexp=85
		--mine
		plr.mspd=60
		plr.meng=5
		plr.mdmg=20
		--empty
		plr.espd=30
		--slow
		plr.cspd=plr.sx/2
		plr.cdmg=plr.mdmg/2
		--energy
		--max 29
		plr.maxeng=29
		plr.eng=29
		
		--upgrades
		plr.usx=0
		plr.umdmg=0
		--negatives
		plr.umspd=0
		plr.umeng=0
		plr.uespd=0
end


function draw_plr()
	if plr.eng<=0 then
		pal(12,8)
	end
	drawspr(plr)
end

function plr_logic()
	chk_inv()
	local mblock=mget((plr.x/8)+1,plr.y/8)
	for gpile in all(garbage) do
		if col(plr,gpile) and plr.msn!='return' then
 		plr.msn='mine'
 		tgpile=gpile
 	end
	end

 if mget((plr.x/8)+1,plr.y/8)==2 and plr.msn!='walk' then 
 	plr.msn='empty'
 end
	
	if plr.msn=='walk' then
		if t>wt then
			plr.sx=1
			plr.flip=false
			if plr.eng>0 then
				plr.x+=plr.sx+plr.usx
			else
				plr.x+=plr.cspd
			end
			if plr.x>132 then
				music(-1,150)
				sfx(13)
				state='win'
				lockout=t+120
			end
		end
	elseif plr.msn=='return'then
		if t>wt then
			plr.flip=true
			plr.sx=1
				if plr.eng>0 then
					plr.x-=plr.sx+plr.usx
				else
					plr.x-=plr.cspd
				end
			end
	elseif plr.msn=='empty' then
		plr.sx=0
		if #plr.inv>0 then
			if t>wt then
				for pu in all(plr.inv) do
					if pu.type==1 then
						pufloat(32,plr.x,plr.y-2,plr.y-10)
						scrapcount+=1
						del(plr.inv,pu)
						wt=t+plr.espd-plr.uespd
						plr.exp+=2
						item_part(plr.x+4,plr.y+2)
						sfx(22)
						return
					elseif pu.type==2 then
						pufloat(36,plr.x,plr.y-2,plr.y-10)
						batcount+=1
						del(plr.inv,pu)
						wt=t+plr.espd-plr.uespd
						plr.exp+=2
						item_part(plr.x+4,plr.y+2)
						sfx(22)
						return
					end
				end
			end
			else
				plr.msn='walk'
		end
	elseif plr.msn=='mine' and plr.flip!=true then
		plr.sx=0
		if plr.eng>0 then
			mineditem=rnd({1,1,1,1,1,2,2,3})
		else
			mineditem=rnd({1,1,1,1,1,1,1,1,1,2,3,3,3})
		end
		if wt<t then
			--mining float pops
			--random drop logic
			if mineditem==1 then
				popfloat('-',plr.x+5,plr.y-2,plr.y-8,7)
				wt=t+plr.mspd-plr.umspd
				plr.exp+=3
			elseif mineditem==2 then
				pufloat(32,plr.x+4,plr.y-2,plr.y-10,1)
				wt=t+plr.mspd-plr.umspd
				add_inv_item(32,1)
				plr.exp+=5
				item_part(plr.x+4,plr.y+4)
			else
				pufloat(36,plr.x,plr.y-2,plr.y-10,1)
				wt=t+plr.mspd-plr.umspd
				add_inv_item(36,2)
				plr.exp+=5
				item_part(plr.x+4,plr.y+4)
			end
			sfx(15)
			block_hit(tgpile.x+4,tgpile.y+4)
			plr.eng-=(plr.meng-plr.umeng)
			if plr.eng<=0 then
				plr.eng=0
				tgpile.life-=plr.cdmg
			else
				tgpile.life-=plr.mdmg
			end
				chk_exp()
				chk_gpile()
				chk_inv()
				--sounds
				--square blinks
		end
	end
end


function chk_inv()
	if t>wt then
		if #plr.inv>=plr.mxinv and plr.msn!='return' then
			plr.msn='return'
		end
	end
end

function chk_exp()
	if plr.exp>=plr.maxexp then
		level_plr()
	end
end

function chk_gpile()
	if tgpile.life<=0 then
		wt=t
		block_destroy(tgpile.x+4,tgpile.y+4)
		plr.msn='walk'
		del(garbage,tgpile)
		sfx(21)
	end
end

function level_plr()
	--enemybuffs
	uenemyfreq+=7
	utmanspd+=.15
	plr.lvl+=1
	--inventory growth
	if plr.lvl==2 then
		plr.mxinv=3
	elseif plr.lvl==4 then
		plr.mxinv=4
	elseif plr.lvl==6 then
		plr.mxinv=5
	end
	--plr base growth
	plr.maxeng+=1
	if plr.usx<=2 then
		plr.usx+=.1
	end
	if plr.umdmg<=80 then
		plr.umdmg+=5
	end
		--negatives
		--reduces time between hits
	if plr.umspd<=55 then
		plr.umspd+=5
	end
	--reduces eng per hit
	if plr.umeng<=4.5 then
		plr.umeng+=0.5
	end
	if plr.uespd<=25 then
		plr.uespd+=5
	end
	--resets level and scales
	plr.exp=0
	plr.maxexp=flr(plr.maxexp*1.2)
	--for loop level up function?
		sfx(10)
end

function add_inv_item(puspr,itype)
	local item=makespr()
	item.spr=puspr
	item.type=itype
	add(plr.inv,item)
end

