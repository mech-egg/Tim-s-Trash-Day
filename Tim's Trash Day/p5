--player functions

function create_plr()
	plr=makespr()
		plr.x=8
		plr.y=104
		plr.spr=16
		plr.sx=1
		plr.mxinv=5
		plr.inv={}
		plr.flip=false
		plr.msn='walk'
		--leveling
		plr.lvl=1
		plr.exp=0
		plr.maxexp=100
		--mine
		plr.mspd=30
		plr.meng=5
		plr.mdmg=10
		--carry
		plr.cspd=plr.sx/2
		
		--energy
		--max 29
		plr.maxeng=29
		plr.eng=29
		
		--upgrades
		plr.usx=0
		plr.umdmg=0
		--negatives
		plr.umspd=0
		plr.umeng=0
end


function draw_plr()
	drawspr(plr)
end

function plr_logic()
	local mblock=mget((plr.x/8)+1,plr.y/8)
	
	for gpile in all(garbage) do
		if col(plr,gpile) and plr.msn!='return' then
 		plr.msn='mine'
 		tgpile=gpile
 	end
	end

 if mget((plr.x/8)+1,plr.y/8)==2 and plr.msn!='walk' then 
 	plr.msn='empty'
 end
	
	if plr.msn=='walk' then
		local lx=plr.x --last x
		local ly=plr.y --last y
		if t>wt then
			plr.sx=1+plr.usx
			plr.flip=false
			if plr.eng>0 then
				plr.x+=plr.sx
			else
				plr.x+=plr.cspd
			end
			if plr.x>132 then
				state='win'
			end
		end
	elseif plr.msn=='return'then
		if t>wt then
			plr.flip=true
			plr.sx=1+plr.usx
				if plr.eng>0 then
					plr.x-=plr.sx
				else
					plr.x-=plr.cspd
				end
			end
	elseif plr.msn=='empty' then
		plr.sx=0
		if #plr.inv>0 then
			if t>wt then
				for pu in all(plr.inv) do
					if pu.type==1 then
						pufloat(32,plr.x+1,plr.y-2,plr.y-10)
						scrapcount+=1
						del(plr.inv,pu)
						wt=t+30
						return
					elseif pu.type==2 then
						pufloat(36,plr.x,plr.y-2,plr.y-10)
						batcount+=1
						del(plr.inv,pu)
						wt=t+30
						return
					end
				end
			end
			else
				plr.msn='walk'
		end
	elseif plr.msn=='mine' and plr.flip!=true then
		plr.sx=0
		rndn=rnd({1,1,1,2,3})
		if wt<t then
			--mining float pops
			--random drop logic
			if rndn==1 then
				popfloat('-',plr.x+5,plr.y-2,plr.y-8,7)
				wt=t+plr.mspd
				plr.exp+=3
			elseif rndn==2 then
				local pu=pufloat(32,plr.x+2,plr.y-2,plr.y-10)
				pufloat(32,plr.x+2,plr.y-2,plr.y-10)
				wt=t+plr.mspd-plr.umspd
				add(plr.inv,pu)
				plr.exp+=5
			else
				local pu=pufloat(36,plr.x,plr.y-2,plr.y-10)
				pufloat(36,plr.x,plr.y-2,plr.y-10)	
				wt=t+plr.mspd-plr.umspd
				add(plr.inv,pu)
				plr.exp+=5
			end
			tgpile.life-=plr.mdmg
			plr.eng-=(plr.meng-plr.umeng)
			if plr.eng<=0 then
				plr.eng=0
			end
				chk_inv()
				chk_exp()
				chk_gpile()
				--sounds
				--square blinks
		end
	end
end


function chk_inv()
	if #plr.inv>=plr.mxinv and plr.msn!='return' then
		plr.msn='return'
	end
end

function chk_exp()
	if plr.exp>=plr.maxexp then
		level_plr()
	end
end

function chk_gpile()
	if tgpile.life<=0 then
		wt=t
		plr.msn='walk'
		del(garbage,tgpile)
	end
end

function level_plr()
	if plr.lvl==2 then
		plr.mxinv=2
	elseif plr.lvl==4 then
		plr.mxinv=3
	elseif plr.lvl==6 then
		plr.mxinv=4
	elseif plr.lvl==8 then
		plr.mxinv=5
	end
	plr.lvl+=1
	plr.maxeng+=1
	plr.usx+=.1
	plr.umdmg+=5
		--negatives
	plr.umspd+=5
	plr.umeng+=0.5
	plr.exp=0
	plr.maxexp=flr(plr.maxexp*1.1)
	--for loop level up function?
end
