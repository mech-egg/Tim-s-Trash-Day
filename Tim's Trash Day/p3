--helper functions

function drawspr(obj)
	spr(obj.spr,obj.x,obj.y,obj.sprw,obj.sprh)
end

function makespr()
	local myspr={}
	myspr.x=0
	myspr.y=0
	myspr.sx=0
	myspr.sy=0
	
	myspr.spr=0
	myspr.sprw=1
	myspr.sprh=1
	myspr.colw=8
	myspr.colh=8
	
	myspr.flash=0
	myspr.shake=0
	myspr.anif=1
	myspr.anispd=0
	myspr.ani={}
	return myspr
end

function col(a,b)
	--a box
	local a_top=a.y
	local a_btm=a.y+a.colh-1
	local a_rgt=a.x+a.colw-1
	local a_lft=a.x
	--b box
	local b_top=b.y
	local b_btm=b.y+b.colh-1
	local b_rgt=b.x+b.colw-1
	local b_lft=b.x
	--find out where the
	--missle isnt
	if a_top>b_btm then return false end
	if b_top>a_btm then return false end
	if a_lft>b_rgt then return false end
	if a_rgt<b_lft then return false end
	
	return true
end

function cprint(txt,x,y,c)
	local ftxt=tostr(txt)
	--move txt half length of txt
	print(ftxt,x-#ftxt*2,y,c)
end

