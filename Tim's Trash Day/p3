--helper functions

function drawspr(obj)
	spr(
	obj.spr,
	obj.x,
	obj.y,
	obj.sprw,
	obj.sprh,
	obj.flip
	)
end

function makespr()
	local myspr={}
	myspr.x=0
	myspr.y=0
	myspr.sx=0
	myspr.sy=0
	
	myspr.spr=0
	myspr.sprw=1
	myspr.sprh=1
	myspr.colw=8
	myspr.colh=8
	
	myspr.flash=0
	myspr.shake=0
	myspr.anif=1
	myspr.anispd=0
	myspr.ani={}
	return myspr
end

function col(a,b)
	local spclay=a.y
	local spclax=a.x
	if a.type=='selector' or b.type=='selector' then
		--make selector col detect
		--smaller
		spclay=spclay+4
		spclax=spclax+4
	end
	--a box
	local a_top=spclay
	local a_btm=spclay+a.colh-1
	local a_rgt=spclax+a.colw-1
	local a_lft=spclax
	--b box
	local b_top=b.y
	local b_btm=b.y+b.colh-1
	local b_rgt=b.x+b.colw-1
	local b_lft=b.x
	--find out where the
	--missle isnt
	if a_top>b_btm then return false end
	if b_top>a_btm then return false end
	if a_lft>b_rgt then return false end
	if a_rgt<b_lft then return false end
	
	return true
end

function friend_col(obj,arr)
	for i=obj.id,#arr do
		for j=i+1,#arr do
			local	obj1=arr[i]
			local obj2=arr[j]
			if col(obj1,obj2) then
				return true
			end
		end
	end
end

function cprint(txt,x,y,c)
	local ftxt=tostr(txt)
	--move txt half length of txt
	print(ftxt,x-#ftxt*2,y,c)
end

function popfloat(fltxt,flx,fly,flposy)
	local fl={}
	fl.x=flx
	fl.y=fly
	fl.posy=flposy
	fl.txt=fltxt
	fl.age=0
	
	
	add(flts,fl)
end

function pufloat(puspr,pux,puy,puposy)
	local pu=makespr()
	pu.x=pux
	pu.y=puy
	pu.posy=puposy
	pu.spr=puspr
	pu.age=0
	if puspr==32 then
		pu.type=1
	else
		pu.type=2
	end
	
	add(pickups,pu)
	return pu
end
