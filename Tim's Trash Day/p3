--helper functions

function drawspr(obj)
	spr(
	obj.spr,
	obj.x,
	obj.y,
	obj.sprw,
	obj.sprh,
	obj.flip
	)
end

function makespr()
	local myspr={}
	myspr.x=0
	myspr.y=0
	myspr.sx=0
	myspr.sy=0
	
	myspr.spr=0
	myspr.sprw=1
	myspr.sprh=1
	myspr.colw=8
	myspr.colh=8
	
	myspr.flash=0
	myspr.shake=0
	myspr.anif=1
	myspr.anispd=0
	myspr.ani={}
	return myspr
end

function col(a,b)

	local spclay=a.y
	local spclax=a.x

	if a.type=='selector' or b.type=='selector' then
		--make selector col detect
		--smaller
		spclay=spclay+4
		spclax=spclax+4
	end
	--a box
	local a_top=spclay
	local a_btm=spclay+a.colh-1
	local a_rgt=spclax+a.colw-1
	local a_lft=spclax
	--b box
	local b_top=b.y
	local b_btm=b.y+b.colh-1
	local b_rgt=b.x+b.colw-1
	local b_lft=b.x
	--find out where the
	--missle isnt
	if a_top>b_btm then return false end
	if b_top>a_btm then return false end
	if a_lft>b_rgt then return false end
	if a_rgt<b_lft then return false end
	
	return true
end
--only checking bottom
function friend_col(obj,arr)
	local pid=obj.id
	for i in all(arr) do
		if i.id!=pid then
			if btm_col(obj,i) then
				return true
			end
		else
			return false
		end
	end
end

function cprint(txt,x,y,c)
	local ftxt=tostr(txt)
	--move txt half length of txt
	print(ftxt,x-#ftxt*2,y,c)
end

function popfloat(fltxt,flx,fly,flposy)
	local fl={}
	fl.x=flx
	fl.y=fly
	fl.posy=flposy
	fl.txt=fltxt
	fl.age=0
	
	
	add(flts,fl)
end

function pufloat(puspr,pux,puy,puposy,pusrc)
	local pu=makespr()
	pu.x=pux
	pu.y=puy
	pu.posy=puposy
	pu.spr=puspr
	pu.age=0
	pu.src=pusrc
	if puspr==32 then
		pu.type=1
	elseif puspr==36 then
		pu.type=2
	end
	
	add(pickups,pu)
	return pu
end

function fcol(tst,flag)
	--get coordinates of plr
	local x1=tst.x/8
	local y1=tst.y/8
	local x2=(tst.x+7)/8
	local y2=(tst.y+7)/8
	
	--check for flag
	local a=fget(mget(x1,y1),flag)
	local b=fget(mget(x2,y1),flag)
	local c=fget(mget(x1,y2),flag)
	local d=fget(mget(x2,y2),flag)
	
	if a or b or c or d then
		return true
	else
		return false
	end
end

function btm_col(a,b)
	--a top
	--b btm

	--a box
	local a_btm=a.y+a.colh-1
	local a_rgt=a.x+a.colw-1
	local a_lft=a.x
	--b box
	local b_top=b.y
	local b_rgt=b.x+b.colw-1
	local b_lft=b.x
	--find out where the
	--missle isnt
	if b_top>a_btm then return false end
	if a_lft>b_rgt then return false end
	if a_rgt<b_lft then return false end
	
	return true
end

function block_hit(x,y)
	for i=1,25 do 
		local p={
			x=x,
			y=y,
			age=rnd(2),
			maxage=10+rnd(15),
			rd=0,
			sx=rnd()*4-2,
			sy=rnd()*2-2
		}
		add(parts,p)
	end
end

function block_destroy(x,y)
	for i=1,30 do 
		local p={
			x=x,
			y=y,
			age=rnd(2),
			maxage=20+rnd(15),
			rd=rnd(3),
			sx=(rnd()-.5)*4,
			sy=(rnd()-.5)*4,
		}
		add(parts,p)
	end
end

function item_part(x,y,clr)
	for i=1,20  do 
		local pp={
			x=x,
			y=y,
			age=rnd(2),
			maxage=25+rnd(20),
			rd=rnd(2),
			sx=(rnd()-.5)*2.5,
			sy=rnd()*-5,
			clr=clr
		}
		add(pparts,pp)
	end
end


